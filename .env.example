# Токены ботов от @BotFather — через запятую, без пробелов.
# Рекомендуется 3-4 штуки (новый принцип ротации — см. README).
# Первый токен в списке = primary: он держит polling и UI
# (команды, статусы, трекинг), остальные включаются в работу
# только при ротации.
BOT_TOKENS=токен1,токен2,токен3,токен4

# Строка подключения к Postgres (Render External Database URL или любая другая)
# Формат: postgresql://user:password@host:port/dbname
DATABASE_URL=

# API_ID и API_HASH userbot-аккаунта с my.telegram.org.
# Теперь используются не только для чтения форумных веток и /sync,
# но и для динамической выдачи прав следующему боту из пула при
# ротации (нужно право "Add New Admins" у самого userbot-аккаунта
# в целевом чате).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Публичный HTTPS-адрес мини-аппа, если используется (можно оставить пустым)
MINIAPP_BASE_URL=
